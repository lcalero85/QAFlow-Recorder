<Window x:Class="QAFlowRecorder.Views.AppDialogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QAFlow Recorder" Width="456" MinWidth="456" SizeToContent="Height" MinHeight="190" MaxHeight="520" WindowStartupLocation="CenterOwner"
 ResizeMode="NoResize" ShowInTaskbar="False" Background="#090D14" Foreground="#F3F7FC" Icon="pack://application:,,,/Assets/qaflow.ico">
 <Border Margin="1" Background="#0B111A" BorderBrush="#26364A" BorderThickness="1" CornerRadius="10" Padding="20">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Width="44" Height="44"><Image Source="pack://application:,,,/Assets/qaflow-logo.png" Width="42" Height="42"/><TextBlock x:Name="IconText" Text="" Visibility="Collapsed"/></Grid>
    <TextBlock Grid.Column="1" x:Name="TitleText" Text="QAFlow Recorder" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </Grid>
   <TextBlock Grid.Row="1" x:Name="MessageText" TextWrapping="Wrap" Foreground="#D7E2EE" Margin="0,18,0,0" LineHeight="20"/>
   <PasswordBox Grid.Row="2" x:Name="PasswordInput" Visibility="Collapsed" Margin="0,14,0,0" Background="#111A27" Foreground="#F3F7FC" BorderBrush="#34465E" Padding="10,8"/>
   <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="SecondaryButton" Content="Cancel" Click="Secondary_Click"/>
    <Button Grid.Column="2" x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="OK" Click="Primary_Click"/>
   </Grid>
  </Grid>
 </Border>
</Window>