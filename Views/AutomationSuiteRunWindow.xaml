<Window x:Class="QAFlowRecorder.Views.AutomationSuiteRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QAFlow · Suite Run" Width="1000" Height="700" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#090D14" Foreground="#F3F7FC"
        Icon="pack://application:,,,/Assets/qaflow.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0E1724" BorderBrush="#28435F" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/qaflow-logo.png" Width="42" Height="42"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="TitleText" Text="Suite execution" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Text="Run the suite sequentially and consolidate results into one report." Foreground="#8FA8C0" Margin="0,3,0,0"/></StackPanel>
                <Border Grid.Column="2" Background="#102638" BorderBrush="#285A7D" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="StatusBadge" Text="READY" Foreground="#77C9FF" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#101925" BorderBrush="#263A50" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="PROJECT" Foreground="#7890A8" FontSize="10"/><TextBlock x:Name="ProjectText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="SUITE" Foreground="#7890A8" FontSize="10"/><TextBlock x:Name="SuiteText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock x:Name="EnvironmentLabel" Text="ENVIRONMENT" Foreground="#7890A8" FontSize="10"/><ComboBox x:Name="EnvironmentBox" Height="32" Margin="0,3,8,0" DisplayMemberPath="DisplayName" SelectionChanged="EnvironmentBox_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="BROWSER" Foreground="#7890A8" FontSize="10"/><TextBlock x:Name="BrowserText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock x:Name="DataLabel" Text="TEST DATA OVERRIDE" Foreground="#7890A8" FontSize="10"/><ComboBox x:Name="DataSetBox" Height="32" Margin="0,3,0,0" DisplayMemberPath="DisplayName" ToolTip="Leave empty to use the environment or test case default data set."/></StackPanel>
            </Grid>
        </Border>
        <DataGrid Grid.Row="4" x:Name="CasesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding TestCaseKey}" Width="90"/>
                <DataGridTextColumn Header="Test case" Binding="{Binding TestCaseName}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Pass" Binding="{Binding PassRate, StringFormat={}{0}%}" Width="75"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>
                <DataGridTextColumn Header="Message" Binding="{Binding FailureMessage}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready to run suite." Foreground="#8FA8C0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="OpenReportButton" Content="Open suite report" Click="OpenReport_Click" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="StopButton" Content="Stop" Style="{StaticResource DangerButton}" Click="Stop_Click" IsEnabled="False"/>
            <Button Grid.Column="5" x:Name="RunButton" Content="▶ Run suite" Style="{StaticResource PrimaryButton}" Click="Run_Click"/>
        </Grid>
    </Grid>
</Window>
