<Window x:Class="QAFlowRecorder.Views.SessionTemplateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Session templates" Width="820" Height="650" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/qaflow.ico">
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="LibraryTitle" Text="Session templates" FontSize="20" FontWeight="SemiBold"/><ListBox Grid.Row="1" x:Name="TemplatesList" Margin="0,12,0,12" DisplayMemberPath="DisplayName" SelectionChanged="TemplatesList_SelectionChanged"/><StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="NewButton" Content="New" Width="72" Click="New_Click"/><Button x:Name="DeleteButton" Content="Delete" Width="72" Margin="8,0,0,0" Click="Delete_Click"/></StackPanel></Grid>
  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="EditorTitle" Text="Template details" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock x:Name="NameLabel" Text="Name" Margin="0,12,0,4"/><TextBox x:Name="NameBox"/>
   <TextBlock x:Name="TestTypeLabel" Text="Test type" Margin="0,10,0,4"/><ComboBox x:Name="TestTypeBox"><ComboBoxItem Content="Functional Normal"/><ComboBoxItem Content="Regression"/><ComboBoxItem Content="UAT"/><ComboBoxItem Content="Smoke"/><ComboBoxItem Content="Exploratory"/></ComboBox>
   <TextBlock x:Name="TagsLabel" Text="Default tags" Margin="0,10,0,4"/><TextBox x:Name="TagsBox"/>
   <TextBlock x:Name="ObjectiveLabel" Text="Default objective" Margin="0,10,0,4"/><TextBox x:Name="ObjectiveBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"/>
   <TextBlock x:Name="RisksLabel" Text="Default risks" Margin="0,10,0,4"/><TextBox x:Name="RisksBox" Height="58" AcceptsReturn="True" TextWrapping="Wrap"/>
   <TextBlock x:Name="ChecklistLabel" Text="Default checklist · one validation per line" Margin="0,10,0,4"/><TextBox x:Name="ChecklistBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   <CheckBox x:Name="PeriodicCheck" Content="Periodic evidence capture" Margin="0,12,0,4"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock x:Name="IntervalLabel" Text="Interval (seconds)" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="IntervalBox" Text="30"/></Grid>
   <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CancelButton" Content="Close" Click="Close_Click"/><Button Grid.Column="2" x:Name="SaveButton" Content="Save template" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></Grid>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
