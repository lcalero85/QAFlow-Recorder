                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RunsScopeText" Text="Phase 9 execution remains web-only and can use project environments while respecting URL scope and allowed domains." Foreground="{DynamicResource TextSubtle2Brush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="OpenRunFolderButton" Content="Open run folder" Click="OpenRunFolder_Click"/>
                                    <Button Grid.Column="3" x:Name="OpenRunReportButton" Content="Open HTML report" Style="{StaticResource PrimaryButton}" Click="OpenRunReport_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="InstrumentationTab" Header="Web Instrumentation">
                            <Grid Margin="14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="InstrumentationTitleText" Text="DOM instrumentation and selector intelligence" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="InstrumentationHelpText" Text="QAFlow enriches recorded web actions with DOM metadata and ranks stable selectors. Typed values are never collected." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="LOCAL BRIDGE" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="BridgeStatusText" Text="Checking..." FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="EXTENSION" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="ExtensionStatusText" Text="Not connected" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="SELECTOR POLICY" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock Text="Stable DOM first" FontSize="16" FontWeight="SemiBold"/></StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock x:Name="InstrumentationStepsTitle" Text="Connect browser instrumentation" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="InstrumentationStepsText" Margin="0,8,0,0" Foreground="{DynamicResource TextSubtleBrush}" TextWrapping="Wrap" Text="Chrome/Edge: open Extensions, enable Developer mode and load WebInstrumentationExtension.&#10;Firefox: open about:debugging, choose This Firefox → Load Temporary Add-on and select WebInstrumentationExtensionFirefox/manifest.json.&#10;&#10;Keep QAFlow in Hybrid Testing with a valid Base URL. Instrumentation communicates only with 127.0.0.1 and sends DOM metadata only inside the configured scope; typed values are never collected."/>
                                        <Border Margin="0,14,0,0" Background="{DynamicResource SurfacePanel2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <TextBlock x:Name="SelectorPolicyText" Text="Selector priority: data-testid → stable id → name → aria-label → role + accessible name → CSS → XPath. UI Automation remains a fallback only." Foreground="{DynamicResource AccentLightBrush}" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="InstrumentationPrivacyText" Text="No field values are captured. Recorder Only disables DOM event acceptance." Foreground="{DynamicResource TextSubtle2Brush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="OpenExtensionFolderButton" Content="Chrome / Edge" Click="OpenExtensionFolder_Click" ToolTip="Open Chromium instrumentation extension folder"/>
                                    <Button Grid.Column="3" x:Name="OpenFirefoxExtensionFolderButton" Content="Firefox" Click="OpenFirefoxExtensionFolder_Click" ToolTip="Open Firefox instrumentation extension folder"/>
                                    <Button Grid.Column="5" x:Name="RefreshInstrumentationButton" Content="Refresh status" Style="{StaticResource PrimaryButton}" Click="RefreshInstrumentation_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="EnvironmentsTab" Header="Environments &amp; Scheduling">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock x:Name="EnvironmentsTitleText" Text="Web environments" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="EnvironmentsHelpText" Text="Reuse the same suites against different web environments without duplicating test cases." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                        <DataGrid Grid.Row="2" x:Name="EnvironmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="EnvironmentsGrid_SelectionChanged">
                                            <DataGrid.Columns><DataGridTextColumn Header="Environment" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Base URL" Binding="{Binding BaseUrl}" Width="2*"/><DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="80"/><DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" Width="65"/></DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="4">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Name" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="EnvironmentNameBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Base URL" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="EnvironmentBaseUrlBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Allowed domains" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="EnvironmentDomainsBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Comma-separated trusted domains."/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Browser" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="EnvironmentBrowserBox" Height="36" Margin="0,4,0,0"><ComboBoxItem Content="Chrome"/><ComboBoxItem Content="Edge"/><ComboBoxItem Content="Firefox"/></ComboBox></StackPanel>
                                                <StackPanel Grid.Column="4"><TextBlock Text="Default test data" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="EnvironmentDataSetBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox x:Name="EnvironmentDefaultCheck" Content="Default environment" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" x:Name="NewEnvironmentButton" Content="＋ New" Click="NewEnvironment_Click"/>
                                                <Button Grid.Column="3" x:Name="SaveEnvironmentButton" Content="Save environment" Style="{StaticResource PrimaryButton}" Click="SaveEnvironment_Click"/>
                                                <Button Grid.Column="5" x:Name="DeleteEnvironmentButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteEnvironment_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock x:Name="SchedulingTitleText" Text="Scheduled suite runs" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SchedulingHelpText" Text="Register recurring web regressions in Windows Task Scheduler. Scheduled runs use QAFlow's headless suite entry point." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                        <DataGrid Grid.Row="2" x:Name="SchedulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="SchedulesGrid_SelectionChanged">
                                            <DataGrid.Columns><DataGridTextColumn Header="Schedule" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="80"/><DataGridTextColumn Header="Time" Binding="{Binding TimeOfDay}" Width="60"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="65"/><DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="1.4*"/></DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="4">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Name" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ScheduleNameBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Suite" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="ScheduleSuiteBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Environment" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="ScheduleEnvironmentBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Frequency" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="ScheduleFrequencyBox" Height="36" Margin="0,4,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="4"><TextBlock Text="Time (HH:mm)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ScheduleTimeBox" Text="22:00" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Weekly days (MON,TUE...)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ScheduleDaysBox" Text="MON" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                    <CheckBox x:Name="ScheduleEnabledCheck" Content="Enabled" IsChecked="True" Margin="0,0,0,4"/>
                                                    <CheckBox x:Name="ScheduleSendCheck" Content="Send report" IsChecked="True" Margin="0,0,0,4"/>
                                                    <CheckBox x:Name="ScheduleBrowserHeadlessCheck" Content="Browser headless (advanced)" ToolTip="Run Chrome, Edge or Firefox without a visible browser window."/>
                                                </StackPanel>
                                                <Button Grid.Column="4" x:Name="SaveScheduleButton" Content="Save" Click="SaveSchedule_Click" VerticalAlignment="Bottom"/>
                                                <Button Grid.Column="6" x:Name="RegisterScheduleButton" Content="Register in Windows" Style="{StaticResource PrimaryButton}" Click="RegisterSchedule_Click" VerticalAlignment="Bottom"/>
                                                <Button Grid.Column="8" x:Name="DeleteScheduleButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteSchedule_Click" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="QueueMatrixTab" Header="Run Queue &amp; Browser Matrix">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="QueueTitleText" Text="Run queue &amp; browser matrix" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="QueueHelpText" Text="Queue the selected suite for Chrome, Edge, Firefox or any combination. QAFlow runs independent web jobs in parallel with a controlled concurrency limit." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="BrowserPreflightButton" Content="Browser preflight" Click="BrowserPreflight_Click" Padding="12,5"/>
                                        <TextBlock x:Name="BrowserPreflightStateText" Text="Check local browser availability before running the matrix." Foreground="{DynamicResource Muted3Brush}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="QueueSuiteLabel" Text="Selected suite" Foreground="{DynamicResource Muted2Brush}"/>
                                            <TextBlock x:Name="QueueSuiteText" Text="—" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="QueueEnvironmentLabel" Text="Environment" Foreground="{DynamicResource Muted2Brush}"/>
                                            <ComboBox x:Name="QueueEnvironmentBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,7"><CheckBox x:Name="QueueChromeCheck" Content="Chrome" IsChecked="True"/></StackPanel>
                                        <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Margin="0,0,0,7"><CheckBox x:Name="QueueEdgeCheck" Content="Edge" IsChecked="True"/></StackPanel>
                                        <StackPanel Grid.Column="8" VerticalAlignment="Bottom" Margin="0,0,0,7"><CheckBox x:Name="QueueFirefoxCheck" Content="Firefox"/></StackPanel>
                                        <StackPanel Grid.Column="10">
                                            <TextBlock x:Name="ConcurrencyLabel" Text="Parallel" Foreground="{DynamicResource Muted2Brush}"/>
                                            <ComboBox x:Name="ConcurrencyBox" Height="36" Margin="0,4,0,0"><ComboBoxItem Content="1"/><ComboBoxItem Content="2" IsSelected="True"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="4" x:Name="RunQueueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Batch" Binding="{Binding BatchDisplay}" Width="80"/>
                                        <DataGridTextColumn Header="Suite" Binding="{Binding SuiteName}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Environment" Binding="{Binding EnvironmentName}" Width="120"/>
                                        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="82"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding BrowserVersion}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedDisplay}" Width="145"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                                    </DataGrid.Columns>
