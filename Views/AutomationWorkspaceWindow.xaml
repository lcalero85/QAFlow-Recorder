                                    <Button Grid.Column="7" x:Name="OpenQueuedReportButton" Content="Open report" Click="OpenQueuedReport_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="QualityAnalyticsTab" Header="Quality Intelligence">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="QualityTitleText" Text="Quality intelligence" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="QualityHelpText" Text="Use execution history to identify flaky tests, recurring failure patterns and quality trends without changing test logic." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock x:Name="QualityPassLabel" Text="HISTORICAL PASS RATE" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="QualityPassText" Text="0%" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/></StackPanel></Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock x:Name="QualityFlakyLabel" Text="FLAKY TESTS" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="QualityFlakyText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/></StackPanel></Border>
                                    <Border Grid.Column="4" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock x:Name="QualityFailuresLabel" Text="RECURRING FAILURES" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="QualityFailuresText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}"/></StackPanel></Border>
                                    <Border Grid.Column="6" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock x:Name="QualityRunsLabel" Text="SUITE RUNS" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="QualityRunsText" Text="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}"/></StackPanel></Border>
                                </Grid>
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock x:Name="StabilityTitleText" Text="Test stability" FontWeight="SemiBold"/>
                                        <DataGrid Grid.Row="2" x:Name="StabilityGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Test case" Binding="{Binding DisplayName}" Width="2*"/>
                                                <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="80"/>
                                                <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="120"/>
                                                <DataGridTextColumn Header="Runs" Binding="{Binding Runs}" Width="55"/>
                                                <DataGridTextColumn Header="Failure" Binding="{Binding FailureRate, StringFormat={}{0}%}" Width="65"/>
                                                <DataGridTextColumn Header="Stability" Binding="{Binding StabilityScore, StringFormat={}{0}%}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="4" x:Name="StabilityHintText" Text="Flaky classification requires both successful and unsuccessful historical outcomes; QAFlow never changes the test automatically." Foreground="{DynamicResource TextSubtle2Brush}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="135"/></Grid.RowDefinitions>
                                        <TextBlock x:Name="FailureClustersTitleText" Text="Failure clusters" FontWeight="SemiBold"/>
                                        <DataGrid Grid.Row="2" x:Name="FailureClustersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="55"/>
                                                <DataGridTextColumn Header="Message" Binding="{Binding SampleMessage}" Width="2*"/>
                                                <DataGridTextColumn Header="Cases" Binding="{Binding TestCaseCount}" Width="55"/>
                                                <DataGridTextColumn Header="Browsers" Binding="{Binding Browsers}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Grid.Row="4" x:Name="TrendTitleText" Text="Recent suite trend" FontWeight="SemiBold"/>
                                        <DataGrid Grid.Row="6" x:Name="AnalyticsTrendGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="AnalyticsTrendGrid_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Started" Binding="{Binding StartedDisplay}" Width="135"/>
                                                <DataGridTextColumn Header="Suite" Binding="{Binding SuiteName}" Width="*"/>
                                                <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="75"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                                                <DataGridTextColumn Header="Pass" Binding="{Binding PassRate, StringFormat={}{0}%}" Width="58"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="QualityStateText" Text="Select a project to analyze its local automation history." Foreground="{DynamicResource Muted3Brush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="RefreshQualityButton" Content="Refresh" Click="RefreshQuality_Click"/>
                                    <Button Grid.Column="3" x:Name="ExportQualityButton" Content="Export HTML" Click="ExportQuality_Click"/>
                                    <Button Grid.Column="5" x:Name="RerunFailedButton" Content="↻ Rerun failed cases" Style="{StaticResource PrimaryButton}" Click="RerunFailed_Click" IsEnabled="False"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="RecordedSessionsTab" Header="Recorded Sessions">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="RecordedSessionsHelpText" Text="Convert finished Recorder sessions into draft web test cases." FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RecordedSessionsScopeText" Text="Only activity inside the project Base URL becomes an automation candidate." Foreground="{DynamicResource TextSubtle2Brush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <DataGrid Grid.Row="2" x:Name="RecordedSessionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="RecordedSessionsGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Session" Binding="{Binding DisplayName}" Width="*"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding StartedDisplay}" Width="115"/>
                                            <DataGridTextColumn Header="Steps" Binding="{Binding ActionCount}" Width="54"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="TargetSuiteLabel" Text="Target suite" Foreground="{DynamicResource Muted2Brush}"/>
                                                <ComboBox x:Name="ConversionSuiteBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectionChanged="ConversionSuiteBox_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="ConversionNameLabel" Text="Test case name" Foreground="{DynamicResource Muted2Brush}"/>
                                                <TextBox x:Name="ConversionNameBox" Height="38" Margin="0,4,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="RECORDED" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="PreviewTotalText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock x:Name="PreviewWebLabel" Text="WEB IN SCOPE" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="PreviewWebText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock x:Name="PreviewManualLabel" Text="MANUAL / EVIDENCE" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="PreviewManualText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock x:Name="PreviewConfidenceLabel" Text="READINESS" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="PreviewConfidenceText" Text="0%" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="4" x:Name="ConversionPreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="65"/>
                                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="75"/>
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="80"/>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="1.4*"/>
                                            <DataGridTextColumn Header="Selector" Binding="{Binding Selector}" Width="1.6*"/>
                                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="85"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ConversionHintText" Text="Phase 9 keeps data-driven execution, secure secrets, suite orchestration and adds reusable environments and scheduled runs." Foreground="{DynamicResource TextSubtle2Brush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="ConvertSessionButton" Content="Convert to Test Case" Style="{StaticResource PrimaryButton}" Padding="16,9" Click="ConvertSession_Click" IsEnabled="False"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Local workspace · Phase 11 quality intelligence enabled · web automation only · desktop automation disabled" Foreground="{DynamicResource Muted3Brush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="SaveButton" Content="Save workspace" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <Button Grid.Column="3" x:Name="CloseButton" Content="Close" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
