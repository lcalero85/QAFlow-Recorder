                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel>
                                            <CheckBox x:Name="StopBatchOnFailureCheck" Content="Stop remaining matrix jobs when one browser fails"/>
                                            <CheckBox x:Name="QueueBrowserHeadlessCheck" Content="Browser headless (advanced)" Margin="0,5,0,0" ToolTip="Run Chrome, Edge or Firefox without opening visible browser windows."/>
                                        </StackPanel>
                                        <TextBlock x:Name="QueueStateText" Text="Queue idle" Foreground="{DynamicResource Muted3Brush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="QueueMatrixButton" Content="＋ Queue browser matrix" Click="QueueMatrix_Click"/>
