                                <StackPanel>
                                    <TextBlock x:Name="RunsTitleText" Text="Web automation runs" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="RunsHelpText" Text="Execution history is immutable and stored locally with step evidence and an offline HTML report." Foreground="{DynamicResource Muted4Brush}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <DataGrid Grid.Row="2" x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Started" Binding="{Binding StartedDisplay}" Width="145"/>
                                        <DataGridTextColumn Header="Test case" Binding="{Binding DisplayName}" Width="2*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95"/>
                                        <DataGridTextColumn Header="Pass" Binding="{Binding PassRate, StringFormat={}{0}%}" Width="70"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="85"/>
                                        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="85"/>
