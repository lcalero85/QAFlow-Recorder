<Window x:Class="QAFlowRecorder.Views.AutomationWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QAFlow Automation Workspace" Width="1120" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/Assets/qaflow.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/qaflow-logo.png" Width="44" Height="44" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Automation Workspace" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="Organize web automation assets without changing Recorder behavior." Foreground="{DynamicResource Muted4Brush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource SurfaceAccentBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadgeText" Text="WEB ONLY · CAPTURE → TEST CASE → RUN" Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold" FontSize="10"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceDeepBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProjectsLabel" Text="Projects" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="NewProjectButton" Content="＋ New" Padding="10,6" Click="NewProject_Click"/>
                    </Grid>
                    <ListBox Grid.Row="2" x:Name="ProjectsList" SelectionChanged="ProjectsList_SelectionChanged" DisplayMemberPath="DisplayName"/>
                    <Button Grid.Row="4" x:Name="DeleteProjectButton" Content="Delete project" Style="{StaticResource DangerButton}" Click="DeleteProject_Click"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfacePanel2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ProjectNameLabel" Text="Project name" FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectNameBox" Margin="0,5,0,0" Height="38" VerticalContentAlignment="Center" TextChanged="ProjectEditor_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="BaseUrlLabel" Text="Base URL" FontWeight="SemiBold"/>
                            <TextBox x:Name="BaseUrlBox" Margin="0,5,0,0" Height="38" VerticalContentAlignment="Center" TextChanged="ProjectEditor_Changed" ToolTip="Required before automation execution is enabled in a later phase."/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock x:Name="BrowserLabel" Text="Browser" FontWeight="SemiBold"/>
                            <ComboBox x:Name="BrowserBox" Margin="0,5,0,0" Height="38" SelectionChanged="ProjectEditor_Changed"><ComboBoxItem Content="Chrome" IsSelected="True"/><ComboBoxItem Content="Edge"/><ComboBoxItem Content="Firefox"/></ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" x:Name="ProjectHintText" Text="Phase 3 can convert recorded web activity into reviewable Test Case drafts. Automatic execution is still disabled." Foreground="{DynamicResource TextSubtle2Brush}" TextWrapping="Wrap"/>

                    <TabControl Grid.Row="4" x:Name="WorkspaceTabs">
                        <TabItem x:Name="SuitesTab" Header="Suites">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SuitesHelpText" Text="Group related test cases into suites." Foreground="{DynamicResource Muted4Brush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="RunSuiteButton" Content="▶ Run suite" Style="{StaticResource PrimaryButton}" Click="RunSuite_Click" IsEnabled="False"/>
                                    <Button Grid.Column="3" x:Name="NewSuiteButton" Content="＋ Suite" Click="NewSuite_Click"/>
                                    <Button Grid.Column="5" x:Name="DeleteSuiteButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteSuite_Click"/>
                                </Grid>
                                <DataGrid Grid.Row="2" x:Name="SuitesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="SuitesGrid_SelectionChanged" CellEditEnding="SuitesGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="55"/>
                                        <DataGridTextColumn Header="Suite" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                                        <DataGridTextColumn Header="Cases" Binding="{Binding TestCases.Count}" Width="70" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="CasesTab" Header="Test Cases">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CasesContextText" Text="Select a suite to manage its test cases." Foreground="{DynamicResource Muted4Brush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="RunCaseButton" Content="▶ Run selected" Style="{StaticResource PrimaryButton}" Click="RunCase_Click" IsEnabled="False"/>
                                    <Button Grid.Column="3" x:Name="NewCaseButton" Content="＋ Test case" Click="NewCase_Click"/>
                                    <Button Grid.Column="5" x:Name="DeleteCaseButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteCase_Click"/>
                                </Grid>
                                <DataGrid Grid.Row="2" x:Name="CasesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CasesGrid_SelectionChanged" CellEditEnding="CasesGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="95"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridComboBoxColumn x:Name="ModeColumn" Header="Mode" SelectedItemBinding="{Binding Mode}" Width="105"/>
                                        <DataGridComboBoxColumn x:Name="StatusColumn" Header="Status" SelectedItemBinding="{Binding Status}" Width="110"/>
                                        <DataGridTextColumn Header="v" Binding="{Binding Version}" Width="42" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Steps" Binding="{Binding Steps.Count}" Width="58" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="CaseDescriptionLabel" Text="Description" Foreground="{DynamicResource Muted2Brush}"/>
                                            <TextBox x:Name="CaseDescriptionBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0" TextChanged="CaseEditor_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="CaseExpectedLabel" Text="Expected outcome" Foreground="{DynamicResource Muted2Brush}"/>
                                            <TextBox x:Name="CaseExpectedBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,4,0,0" TextChanged="CaseEditor_Changed"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="2" Grid.ColumnSpan="3" x:Name="CaseStepsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="42"/>
                                                <DataGridTextColumn Header="Mode" Binding="{Binding IsManualCheckpoint}" Width="65"/>
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="85"/>
                                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                                                <DataGridTextColumn Header="URL" Binding="{Binding SourceUrl}" Width="1.5*"/>
                                                <DataGridTextColumn Header="DOM selector" Binding="{Binding SelectorProfile.PrimaryDisplay}" Width="2*"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding ValueExpression}" Width="120"/>
                                                <DataGridTextColumn Header="Assertions" Binding="{Binding Assertions.Count}" Width="75"/>
                                                <DataGridTextColumn Header="Confidence" Binding="{Binding AutomationConfidence}" Width="85"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="GovernanceTab" Header="Governance &amp; Audit">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="GovernanceTitleText" Text="Versioning, approval &amp; audit" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="GovernanceHelpText" Text="Keep immutable test-case versions, review approvals and a local audit trail. Recorder behavior is unchanged." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Selected test case" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/>
                                            <TextBlock x:Name="GovernanceCaseText" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                            <TextBlock x:Name="GovernanceStateText" Text="Select a test case." Foreground="{DynamicResource Muted2Brush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="VersionNoteLabel" Text="Version / review note" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/>
                                            <TextBox x:Name="VersionNoteBox" Height="38" Margin="0,5,0,0" VerticalContentAlignment="Center"/>
                                            <CheckBox x:Name="RequireApprovalCheck" Content="Require approved version for Assisted/Automated runs" Margin="0,8,0,0" Click="RequireApprovalCheck_Click"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="4" VerticalAlignment="Center" MaxWidth="390">
                                            <Button x:Name="CreateVersionButton" Content="Create version" Click="CreateVersion_Click" Margin="3"/>
                                            <Button x:Name="SubmitReviewButton" Content="Submit review" Click="SubmitReview_Click" Margin="3"/>
                                            <Button x:Name="ApproveButton" Content="Approve" Style="{StaticResource PrimaryButton}" Click="Approve_Click" Margin="3"/>
                                            <Button x:Name="RejectButton" Content="Reject" Style="{StaticResource DangerButton}" Click="Reject_Click" Margin="3"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Version history" FontWeight="SemiBold"/>
                                        <DataGrid Grid.Row="2" x:Name="VersionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/>
                                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="135"/>
                                                <DataGridTextColumn Header="By" Binding="{Binding CreatedBy}" Width="110"/>
                                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="4" x:Name="RestoreVersionButton" Content="Restore as new version" Click="RestoreVersion_Click" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Audit trail" FontWeight="SemiBold"/>
                                        <DataGrid Grid.Row="2" x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Time" Binding="{Binding TimestampDisplay}" Width="145"/>
                                                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="105"/>
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130"/>
                                                <DataGridTextColumn Header="Entity" Binding="{Binding EntityName}" Width="1.2*"/>
                                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="4" x:Name="RefreshAuditButton" Content="Refresh" Click="RefreshAudit_Click" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </TabItem>


                        <TabItem x:Name="DataAssertionsTab" Header="Test Data &amp; Assertions">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="150"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock x:Name="TestDataTitleText" Text="Test data sets" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TestDataHelpText" Text="Variables resolve expressions such as ${username}. Secrets stay in Windows Credential Manager." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                            <Button Grid.Column="1" x:Name="NewDataSetButton" Content="＋ Data set" Click="NewDataSet_Click"/>
                                            <Button Grid.Column="3" x:Name="DeleteDataSetButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteDataSet_Click"/>
                                        </Grid>
                                        <DataGrid Grid.Row="2" x:Name="DataSetsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DataSetsGrid_SelectionChanged" CellEditEnding="DataSetsGrid_CellEditEnding">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Data set" Binding="{Binding Name}" Width="2*"/>
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                                                <DataGridTextColumn Header="Vars" Binding="{Binding Variables.Count}" Width="55" IsReadOnly="True"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock x:Name="VariableNameLabel" Text="Variable" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="VariableNameBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock x:Name="VariableValueLabel" Text="Value" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="VariableValueBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/><PasswordBox x:Name="VariableSecretBox" Height="36" Margin="0,4,0,0" Visibility="Collapsed"/></StackPanel>
                                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom"><CheckBox x:Name="VariableSecretCheck" Content="Secret" Checked="VariableSecretCheck_Changed" Unchecked="VariableSecretCheck_Changed"/><Button x:Name="SaveVariableButton" Content="Add / update" Margin="0,6,0,0" Click="SaveVariable_Click"/></StackPanel>
                                        </Grid>
                                        <DataGrid Grid.Row="6" x:Name="VariablesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="VariablesGrid_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Variable" Binding="{Binding Name}" Width="2*"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="85"/>
                                                <DataGridTextColumn Header="Value" Binding="{Binding DisplayValue}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Grid.Row="6" x:Name="DeleteVariableButton" Content="Delete selected variable" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Click="DeleteVariable_Click"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock x:Name="AssertionsTitleText" Text="Step data &amp; assertions" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="AssertionsHelpText" Text="Bind input/select values to test data and validate the expected browser state after a step." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock x:Name="AssertionCaseLabel" Text="Test case" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="AssertionCaseBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectionChanged="AssertionCaseBox_SelectionChanged"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock x:Name="AssertionStepLabel" Text="Step" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="AssertionStepBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectionChanged="AssertionStepBox_SelectionChanged"/></StackPanel>
                                        </Grid>
                                        <Border Grid.Row="4" Background="{DynamicResource SurfacePanel2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock x:Name="DefaultDataSetLabel" Text="Default data set" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="DefaultDataSetBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectionChanged="DefaultDataSetBox_SelectionChanged"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock x:Name="ValueExpressionLabel" Text="Step value expression" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ValueExpressionBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" TextChanged="ValueExpressionBox_TextChanged" ToolTip="Examples: ${username}, ${password}, Active"/></StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ComboBox x:Name="AssertionTypeBox" Grid.Column="0" Height="36"/>
                                                <TextBox x:Name="AssertionExpectedBox" Grid.Column="2" Height="36" VerticalContentAlignment="Center" ToolTip="VisualBaselineMatch: 0-100. Performance budgets use milliseconds: MaxPageLoadMs, MaxDomContentLoadedMs, MaxFirstContentfulPaintMs, MaxResourceDurationMs. NoConsoleErrors/NoNetworkErrors need no value."/>
                                                <Button x:Name="AddAssertionButton" Grid.Column="4" Content="＋ Assertion" Click="AddAssertion_Click"/>
                                                <Button x:Name="DeleteAssertionButton" Grid.Column="6" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteAssertion_Click"/>
                                            </Grid>
                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="VisualBaselineStatusText" VerticalAlignment="Center" Foreground="{DynamicResource Muted4Brush}" Text="Visual baseline: select a step." TextTrimming="CharacterEllipsis"/>
                                                <Button x:Name="UpdateAutomationVisualBaselineButton" Grid.Column="1" Margin="10,0,0,0" Content="Update visual baseline from latest run" Click="UpdateAutomationVisualBaseline_Click"/>
                                            </Grid>
                                            <DataGrid Grid.Row="4" x:Name="AssertionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Assertion" Binding="{Binding Type}" Width="180"/>
                                                    <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/>
                                                    <DataGridCheckBoxColumn Header="Step target" Binding="{Binding UseStepTarget}" Width="90"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>


                        <TabItem x:Name="LifecycleDataTab" Header="Lifecycle &amp; Data-driven">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="LifecycleTitleText" Text="Advanced test lifecycle" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LifecycleHelpText" Text="Optional reusable fixtures run around suites and test cases. They never block the normal Recorder workflow." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                                        <TextBlock Text="Suite hooks" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}"/>
                                        <Grid Margin="0,6,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock x:Name="BeforeSuiteLabel" Text="Before suite" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="BeforeSuiteComponentBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock x:Name="AfterSuiteLabel" Text="After suite" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="AfterSuiteComponentBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                        </Grid>
                                        <Separator Background="{DynamicResource BorderStrongBrush}" Margin="0,2,0,10"/>
                                        <TextBlock Text="Test case lifecycle" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}"/>
                                        <TextBlock x:Name="LifecycleCaseLabel" Text="Test case" Foreground="{DynamicResource Muted2Brush}" Margin="0,6,0,0"/><ComboBox x:Name="LifecycleCaseBox" Height="36" Margin="0,4,0,8" DisplayMemberPath="DisplayName" SelectionChanged="LifecycleCaseBox_SelectionChanged"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock x:Name="BeforeTestLabel" Text="Before test" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="BeforeTestComponentBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock x:Name="AfterTestLabel" Text="After test" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="AfterTestComponentBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/></StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="DependencyLabel" Text="Run only after this case passes (optional)" Foreground="{DynamicResource Muted2Brush}" Margin="0,8,0,0"/>
                                        <ComboBox x:Name="DependencyCaseBox" Height="36" Margin="0,4,0,0" DisplayMemberPath="DisplayName"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock x:Name="DataDrivenTitleText" Text="Data-driven execution" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DataDrivenHelpText" Text="Run the selected test case once for each selected data set. Each iteration keeps its own evidence and HTML report." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                        <CheckBox Grid.Row="2" x:Name="DataDrivenEnabledCheck" Content="Enable multiple data iterations for this case"/>
                                        <ListBox Grid.Row="4" x:Name="DataDrivenSetsList" DisplayMemberPath="DisplayName" SelectionMode="Extended"/>
                                        <TextBlock Grid.Row="6" x:Name="DataDrivenHintText" Text="Tip: Ctrl/Shift selects multiple data sets. Secrets remain in Windows Credential Manager." Foreground="{DynamicResource TextSubtle4Brush}" TextWrapping="Wrap" Margin="0,0,0,42"/>
                                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button x:Name="ClearLifecycleButton" Content="Clear advanced settings" Margin="0,0,8,0" Click="ClearLifecycle_Click"/><Button x:Name="SaveLifecycleButton" Content="Save advanced lifecycle &amp; data settings" Style="{StaticResource PrimaryButton}" Click="SaveLifecycle_Click"/></StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="ComponentsRecoveryTab" Header="Components &amp; Recovery">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock x:Name="ComponentsTitleText" Text="Reusable web components" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ComponentsHelpText" Text="Promote stable test flows into reusable building blocks and insert them into other test cases." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                        <DataGrid Grid.Row="2" x:Name="ComponentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ComponentsGrid_SelectionChanged">
                                            <DataGrid.Columns><DataGridTextColumn Header="Component" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Steps" Binding="{Binding Steps.Count}" Width="70"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*"/></DataGrid.Columns>
                                        </DataGrid>
                                        <Grid Grid.Row="4">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="Name" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ComponentNameBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Description" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ComponentDescriptionBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Button x:Name="CreateComponentButton" Content="Save selected case as component" Click="CreateComponent_Click"/>
                                                <Button Grid.Column="2" x:Name="InsertComponentButton" Content="Insert into selected case" Style="{StaticResource PrimaryButton}" Click="InsertComponent_Click"/>
                                                <Button Grid.Column="4" x:Name="DeleteComponentButton" Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteComponent_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock x:Name="RecoveryTitleText" Text="Recovery &amp; self-healing" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RecoveryHelpText" Text="Configure retries and failure behavior. When stable selectors break, QAFlow attempts a conservative semantic recovery before asking the QA or failing the test." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Test case" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="RecoveryCaseBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectionChanged="RecoveryCaseBox_SelectionChanged"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Step" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="RecoveryStepBox" Height="38" Margin="0,4,0,0" DisplayMemberPath="DisplayName" SelectionChanged="RecoveryStepBox_SelectionChanged"/></StackPanel>
                                        </Grid>
                                        <Border Grid.Row="4" Background="{DynamicResource SurfacePanel2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
                                            <StackPanel>
                                                <TextBlock x:Name="SmartWaitLabel" Text="Smart wait" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,6"/>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock x:Name="WaitConditionLabel" Text="Condition" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="WaitConditionBox" Height="36" Margin="0,4,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock x:Name="WaitTimeoutLabel" Text="Timeout (ms)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="WaitTimeoutBox" Text="10000" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock x:Name="WaitPollLabel" Text="Poll (ms)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="WaitPollBox" Text="250" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                </Grid>
                                                <Separator Margin="0,10" Background="{DynamicResource BorderStrongBrush}"/>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Retries" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="RecoveryRetriesBox" Text="1" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Delay (ms)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="RecoveryDelayBox" Text="600" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="On failure" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="FailureActionBox" Height="36" Margin="0,4,0,0"/></StackPanel>
                                                </Grid>
                                                <Separator Margin="0,10" Background="{DynamicResource BorderStrongBrush}"/>
                                                <TextBlock x:Name="AdvancedInteractionLabel" Text="Advanced web interaction" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock x:Name="InteractionActionLabel" Text="Action" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="InteractionActionBox" Height="36" Margin="0,4,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock x:Name="InteractionValueHelpText" Text="Value expression: KeyPress = ENTER/CTRL+A · UploadFile = file path · ValidateDownload = *.pdf · SetCookie/Storage = key=value · Delete/Remove = key or cookie name." Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                                                        <CheckBox x:Name="JavaScriptClickFallbackCheck" Margin="0,7,0,0" Content="Allow JavaScript click fallback when a normal click is intercepted"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Expander x:Name="ConditionalExecutionExpander" Header="Conditional execution (advanced)" Margin="0,10,0,0" IsExpanded="False">
                                                    <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePanel3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
                                                        <StackPanel>
                                                            <TextBlock x:Name="ConditionHelpText" Text="Optionally run this step only when a safe browser/data condition is met. False conditions mark the step as Skipped, not Failed." Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <StackPanel><TextBlock x:Name="ConditionTypeLabel" Text="Condition" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="ConditionTypeBox" Height="34" Margin="0,4,0,0"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock x:Name="ConditionExpressionLabel" Text="Expression / selector / text" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ConditionExpressionBox" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Examples: .promo-modal, /checkout, ${role}"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock x:Name="ConditionExpectedLabel" Text="Expected value" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ConditionExpectedBox" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Used by variable equality conditions."/></StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                                <Expander x:Name="ControlledRepeatExpander" Header="Controlled repetition (advanced)" Margin="0,10,0,0" IsExpanded="False">
                                                    <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePanel3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
                                                        <StackPanel>
                                                            <TextBlock x:Name="RepeatHelpText" Text="Repeat this step a bounded number of times. Use Data-driven execution for different data rows; use repetition only for stability or repeated UI checks." Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <StackPanel><TextBlock x:Name="RepeatCountLabel" Text="Iterations (1–20)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="RepeatCountBox" Text="1" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock x:Name="RepeatDelayLabel" Text="Delay between iterations (ms)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="RepeatDelayBox" Text="0" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                                <Expander x:Name="ApiHelperExpander" Header="API helper (advanced)" Margin="0,10,0,0" IsExpanded="False">
                                                    <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePanel3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
                                                        <StackPanel>
                                                            <TextBlock x:Name="ApiHelperHelpText" Text="Optional setup/cleanup request. The endpoint must remain inside the project Base URL or allowed domains." Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                                                <StackPanel><TextBlock x:Name="ApiMethodLabel" Text="Method" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="ApiMethodBox" Height="34" Margin="0,4,0,0"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock x:Name="ApiUrlLabel" Text="URL / relative endpoint" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ApiUrlBox" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Examples: /api/test-data/customer or https://qa.example.com/api/health"/></StackPanel>
                                                                <StackPanel Grid.Column="4"><TextBlock x:Name="ApiStatusLabel" Text="Expected status" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ApiExpectedStatusBox" Text="200" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                            </Grid>
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <StackPanel><TextBlock x:Name="ApiContentTypeLabel" Text="Content-Type" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ApiContentTypeBox" Text="application/json" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock x:Name="ApiHeadersLabel" Text="Headers (one per line: Name=Value)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="ApiHeadersBox" Height="62" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                                                            </Grid>
                                                            <TextBlock x:Name="ApiBodyLabel" Text="Request body (supports Data Set variables)" Foreground="{DynamicResource Muted2Brush}" Margin="0,8,0,0"/>
                                                            <TextBox x:Name="ApiBodyBox" Height="72" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                                <Expander x:Name="SelfHealingExpander" Header="Self-healing intelligence (advanced)" Margin="0,10,0,0" IsExpanded="False">
                                                    <Border Margin="0,6,0,0" Background="{DynamicResource SurfacePanel3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
                                                        <StackPanel>
                                                            <TextBlock x:Name="SelfHealingHelpText" Text="Advanced mode scores semantic and structural signals, only accepts a clear best match, and can learn the recovered selector. Conservative mode preserves the previous behavior." Foreground="{DynamicResource Muted2Brush}" TextWrapping="Wrap"/>
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                                <StackPanel><TextBlock x:Name="HealingModeLabel" Text="Mode" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="HealingModeBox" Height="34" Margin="0,4,0,0"/></StackPanel>
                                                                <StackPanel Grid.Column="2"><TextBlock x:Name="HealingScoreLabel" Text="Minimum score (0-100)" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="HealingMinimumScoreBox" Text="78" Height="34" Margin="0,4,0,0" VerticalContentAlignment="Center"/></StackPanel>
                                                                <CheckBox x:Name="LearnHealedSelectorCheck" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,8" Content="Learn successful selector"/>
                                                            </Grid>
                                                            <TextBlock x:Name="SelfHealingSignalsText" Margin="0,7,0,0" Foreground="{DynamicResource TextSubtle4Brush}" TextWrapping="Wrap" Text="Advanced scoring: accessible name, role, tag, label/placeholder/title, visible text and local DOM context. A close second candidate is rejected to avoid unsafe healing."/>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                                <Separator Margin="0,10" Background="{DynamicResource BorderStrongBrush}"/>
                                                <TextBlock x:Name="BrowserContextLabel" Text="Browser context · tabs/windows &amp; iframe" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock x:Name="WindowTargetLabel" Text="Window / tab" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="WindowTargetBox" Height="36" Margin="0,4,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock x:Name="WindowMatchLabel" Text="Title contains" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="WindowMatchBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Used only with TitleContains."/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock x:Name="FrameTargetLabel" Text="Frame" Foreground="{DynamicResource Muted2Brush}"/><ComboBox x:Name="FrameTargetBox" Height="36" Margin="0,4,0,0"/></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock x:Name="FrameValueLabel" Text="Frame value" Foreground="{DynamicResource Muted2Brush}"/><TextBox x:Name="FrameValueBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="CSS selector, name/id or zero-based index depending on Frame."/></StackPanel>
                                                    <CheckBox x:Name="CloseWindowAfterStepCheck" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,9" Content="Close current tab/window after assertions"/>
                                                </Grid>
                                                <Separator Margin="0,10" Background="{DynamicResource BorderStrongBrush}"/>
                                                <TextBlock x:Name="ShadowDomLabel" Text="Shadow DOM (advanced)" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <CheckBox x:Name="ShadowDomCheck" VerticalAlignment="Center" Content="Resolve target inside open Shadow DOM"/>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock x:Name="ShadowCssPathLabel" Text="Shadow CSS path" Foreground="{DynamicResource Muted2Brush}"/>
                                                        <TextBox x:Name="ShadowCssPathBox" Height="36" Margin="0,4,0,0" VerticalContentAlignment="Center" ToolTip="Use CSS segments separated by >>>, e.g. my-app >>> qa-panel >>> button.save"/>
                                                        <TextBlock x:Name="ShadowDomHelpText" Margin="0,4,0,0" Foreground="{DynamicResource TextSubtle4Brush}" TextWrapping="Wrap" Text="Open shadow roots only. Use >>> between each host/root segment. Closed shadow roots remain inaccessible to browser automation."/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="6">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HealingStatusText" Text="Self-healing defaults to Conservative. Advanced mode uses scored semantic + structural matching with an ambiguity guard; learned selectors remain optional." Foreground="{DynamicResource AccentLightBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="SaveRecoveryButton" Content="Save recovery policy" Style="{StaticResource PrimaryButton}" Click="SaveRecovery_Click"/></Grid>
                                            <DataGrid Grid.Row="2" x:Name="RecoveryStepsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                                                <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Order}" Width="42"/><DataGridTextColumn Header="Step" Binding="{Binding Target}" Width="2*"/><DataGridTextColumn Header="Action" Binding="{Binding InteractionDisplay}" Width="140"/><DataGridTextColumn Header="Wait" Binding="{Binding WaitDisplay}" Width="120"/><DataGridTextColumn Header="Browser context" Binding="{Binding BrowserContextDisplay}" Width="180"/><DataGridTextColumn Header="Retries" Binding="{Binding MaxRetries}" Width="70"/><DataGridTextColumn Header="Failure" Binding="{Binding OnFailure}" Width="120"/><DataGridTextColumn Header="Healed" Binding="{Binding HealingCount}" Width="70"/><DataGridTextColumn Header="Selector" Binding="{Binding SelectorProfile.PrimaryDisplay}" Width="2*"/></DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="SuiteRunsTab" Header="Suite Runs">
                            <Grid Margin="10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SuiteRunsTitleText" Text="Suite execution history" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SuiteRunsHelpText" Text="Execute complete suites sequentially and consolidate all test case results in one offline HTML report." Foreground="{DynamicResource Muted4Brush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <DataGrid Grid.Row="2" x:Name="SuiteRunsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Started" Binding="{Binding StartedDisplay}" Width="145"/>
                                        <DataGridTextColumn Header="Suite" Binding="{Binding SuiteName}" Width="2*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Pass" Binding="{Binding PassRate, StringFormat={}{0}%}" Width="70"/>
                                        <DataGridTextColumn Header="Passed" Binding="{Binding PassedCases}" Width="65"/>
                                        <DataGridTextColumn Header="Failed" Binding="{Binding FailedCases}" Width="65"/>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SuiteRunsScopeText" Text="Suite orchestration remains web-only and uses the same URL scope and recovery rules as individual runs." Foreground="{DynamicResource TextSubtle2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" x:Name="OpenSuiteRunFolderButton" Content="Open folder" Click="OpenSuiteRunFolder_Click"/>
                                    <Button Grid.Column="3" x:Name="OpenSuiteRunReportButton" Content="Open HTML report" Click="OpenSuiteRunReport_Click"/>
                                    <Button Grid.Column="5" x:Name="SendSuiteRunButton" Content="✉ Send report" Style="{StaticResource PrimaryButton}" Click="SendSuiteRun_Click"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="DeliveryTab" Header="Report Delivery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DeliveryTitleText" Text="Email report delivery" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DeliveryHelpText" Text="Send suite HTML reports and selected QA/Bug PDFs through your organization's SMTP server. Passwords are stored in Windows Credential Manager." Foreground="{DynamicResource Muted4Brush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="DeliveryEnabledCheck" Content="Enable email delivery for this project" Checked="DeliveryEditor_Changed" Unchecked="DeliveryEditor_Changed"/>
                                            <CheckBox Grid.Column="2" x:Name="AutoSendCheck" Content="Send automatically after suite run" Checked="DeliveryEditor_Changed" Unchecked="DeliveryEditor_Changed"/>
                                            <StackPanel Grid.Row="2"><TextBlock Text="SMTP host" FontWeight="SemiBold"/><TextBox x:Name="SmtpHostBox" Margin="0,5,0,0" TextChanged="DeliveryText_Changed"/></StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Port" FontWeight="SemiBold"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SmtpPortBox" Text="587" TextChanged="DeliveryText_Changed"/><CheckBox Grid.Column="1" x:Name="SmtpSslCheck" Content="SSL/TLS" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="True" Checked="DeliveryEditor_Changed" Unchecked="DeliveryEditor_Changed"/></Grid></StackPanel>
                                            <StackPanel Grid.Row="4"><TextBlock Text="Username" FontWeight="SemiBold"/><TextBox x:Name="SmtpUserBox" Margin="0,5,0,0" TextChanged="DeliveryText_Changed"/></StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Password" FontWeight="SemiBold"/><PasswordBox x:Name="SmtpPasswordBox" Margin="0,5,0,0" PasswordChanged="SmtpPasswordBox_PasswordChanged" ToolTip="Stored securely in Windows Credential Manager."/></StackPanel>
                                            <StackPanel Grid.Row="6"><TextBlock Text="From address" FontWeight="SemiBold"/><TextBox x:Name="FromAddressBox" Margin="0,5,0,0" TextChanged="DeliveryText_Changed"/></StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Recipients" FontWeight="SemiBold"/><TextBox x:Name="RecipientsBox" Margin="0,5,0,0" TextChanged="DeliveryText_Changed" ToolTip="Separate recipients with comma or semicolon."/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal"><CheckBox x:Name="AttachSuiteHtmlCheck" Content="Attach suite HTML" IsChecked="True" Checked="DeliveryEditor_Changed" Unchecked="DeliveryEditor_Changed"/><CheckBox x:Name="AttachCaseHtmlCheck" Content="Attach individual case HTML reports" Margin="18,0,0,0" Checked="DeliveryEditor_Changed" Unchecked="DeliveryEditor_Changed"/></StackPanel>
                                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PdfAttachmentsLabel" Text="QA/Bug PDF attachments" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="AddPdfButton" Content="＋ Add PDF" Click="AddPdf_Click"/><Button Grid.Column="3" x:Name="RemovePdfButton" Content="Remove" Click="RemovePdf_Click"/></Grid>
