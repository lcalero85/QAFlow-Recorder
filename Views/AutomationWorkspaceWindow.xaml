                                        <TextBlock x:Name="DeliveryStatusText" Text="Delivery settings are local to this project." Foreground="{DynamicResource TextSubtle2Brush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="TestEmailButton" Content="Send test email" Click="TestEmail_Click"/>
