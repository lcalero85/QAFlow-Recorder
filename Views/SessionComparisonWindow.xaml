<Window x:Class="QAFlowRecorder.Views.SessionComparisonWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Session comparison" Width="620" Height="590" WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/qaflow.ico">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="TitleText" Text="Session comparison summary" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" TextWrapping="Wrap"/></StackPanel>
 <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14"><Border Style="{StaticResource ExportCard}"><StackPanel><TextBlock x:Name="DurationValue" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="DurationLabel" Text="Duration" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource ExportCard}"><StackPanel><TextBlock x:Name="ActionsValue" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="ActionsLabel" Text="Interactions" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource ExportCard}"><StackPanel><TextBlock x:Name="BugValue" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="BugLabel" Text="Bugs" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource ExportCard}"><StackPanel><TextBlock x:Name="StepValue" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="StepLabel" Text="Flow delta" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border><Border Style="{StaticResource ExportCard}"><StackPanel><TextBlock x:Name="VisualValue" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="VisualLabel" Text="Visual changes" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></UniformGrid>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock x:Name="NewTitle" Text="New in this run" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox x:Name="NewList"/></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock x:Name="MissingTitle" Text="Missing vs previous run" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox x:Name="MissingList"/></StackPanel></Border></Grid>
 <Button Grid.Row="3" x:Name="CloseButton" Content="Close" Width="130" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click"/>
 </Grid>
</Window>
