<Window x:Class="QAFlowRecorder.Views.CaptureAreaSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="#66000000" Topmost="True" ShowInTaskbar="False" Cursor="Cross">
    <Grid x:Name="Root" Background="#52000000" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove" MouseLeftButtonUp="Root_MouseLeftButtonUp" KeyDown="Root_KeyDown" Focusable="True">
        <Canvas x:Name="OverlayCanvas">
            <Border x:Name="SelectionBorder" Visibility="Collapsed" BorderBrush="#4DA3FF" BorderThickness="2" Background="#18FFFFFF"/>
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Padding="16,10" CornerRadius="10" Background="#E6212730" BorderBrush="#554DA3FF" BorderThickness="1" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="InstructionTitle" Text="Drag to select the recording area" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="InstructionText" Text="Release to confirm · Esc to cancel" Foreground="#D9E6F2" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
