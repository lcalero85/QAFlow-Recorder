<Window x:Class="QAFlowRecorder.Views.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add annotation" Width="456" Height="500" MinWidth="456" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False" Icon="pack://application:,,,/Assets/qaflow.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Assets/qaflow-logo.png" Width="38" Height="38" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Flow annotation" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" Text="Add a short note to the current point in the QA flow." Foreground="{DynamicResource MutedBrush}" FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderExact1Brush}" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="NoteLabel" Text="Annotation *" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" x:Name="NoteHelpText" Text="Use annotations for context, observations or reminders. Use Bug when a defect requires formal tracking." Foreground="{DynamicResource MutedExact4Brush}" FontSize="9.8" TextWrapping="Wrap" Margin="0,4,0,9"/>
                <TextBox Grid.Row="2" x:Name="NoteBox" Height="160" MinHeight="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource SurfaceExact2Brush}" BorderBrush="{DynamicResource BorderExact2Brush}" BorderThickness="1" CornerRadius="8" Padding="11">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="📷" FontSize="18" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="CaptureBox" Content="Capture screenshot when saving this annotation" IsChecked="True" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CaptureHelpText" Text="QAFlow hides its controls and captures the active target window." Foreground="{DynamicResource MutedExact4Brush}" FontSize="9.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button Grid.Column="2" x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save annotation" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>