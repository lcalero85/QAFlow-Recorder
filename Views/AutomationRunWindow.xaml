<Window x:Class="QAFlowRecorder.Views.AutomationRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QAFlow · Web Automation Run" Width="960" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/Assets/qaflow.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderAltBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/qaflow-logo.png" Width="42" Height="42"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="RunTitleText" Text="Web automation run" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="RunSubtitleText" Text="Selenium execution is constrained to the configured project URL." Foreground="{DynamicResource Muted4Brush}" Margin="0,3,0,0"/></StackPanel>
                <Border Grid.Column="2" Background="{DynamicResource SurfaceAccentBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="StatusBadge" Text="READY" Foreground="{DynamicResource AccentLightBrush}" FontWeight="SemiBold"/></Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="PROJECT" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="ProjectText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="TEST CASE" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="CaseText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="BROWSER" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="BrowserText" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="WEB SCOPE" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><TextBlock x:Name="ScopeText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock x:Name="DataSetLabel" Text="TEST DATA" Foreground="{DynamicResource Muted3Brush}" FontSize="10"/><ComboBox x:Name="DataSetBox" Margin="8,2,0,0" Height="32" DisplayMemberPath="DisplayName" ToolTip="Select the data set used to resolve ${variables}."/></StackPanel>
            </Grid>
        </Border>
        <DataGrid Grid.Row="4" x:Name="RunStepsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="45"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="105"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="95"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="1.5*"/>
                <DataGridTextColumn Header="Assertions" Binding="{Binding AssertionSummary}" Width="80"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="RunStatusText" Text="Ready to run." Foreground="{DynamicResource Muted4Brush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="OpenReportButton" Content="Open HTML report" Click="OpenReport_Click" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="CancelRunButton" Content="Stop" Style="{StaticResource DangerButton}" Click="CancelRun_Click" IsEnabled="False"/>
            <Button Grid.Column="5" x:Name="StartRunButton" Content="▶ Run test case" Style="{StaticResource PrimaryButton}" Click="StartRun_Click"/>
        </Grid>
    </Grid>
</Window>
