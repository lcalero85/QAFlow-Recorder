<Window x:Class="QAFlowRecorder.Views.EvidenceTimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidence timeline — QAFlow" Width="1080" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#090D14" Foreground="#F3F7FC"
        Icon="pack://application:,,,/Assets/qaflow.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/qaflow-logo.png" Width="34" Height="34" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="Evidence timeline" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtitleText" Text="Review the visual evidence captured during this session." Foreground="#8FA3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" x:Name="OpenFolderButton" Content="Open evidence folder" Click="OpenFolder_Click" Padding="14,8" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#101925" BorderBrush="#26364A" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ComboBox x:Name="FilterBox" Height="36" SelectionChanged="FilterBox_SelectionChanged">
                        <ComboBoxItem Content="All evidence" IsSelected="True"/>
                        <ComboBoxItem Content="Flow actions"/>
                        <ComboBoxItem Content="Annotations"/>
                        <ComboBoxItem Content="Manual captures"/>
                        <ComboBoxItem Content="Bugs"/>
                    </ComboBox>
                    <ListBox Grid.Row="2" x:Name="TimelineList" Background="Transparent" BorderThickness="0" SelectionChanged="TimelineList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" Background="#111A27" BorderBrush="#26364A" BorderThickness="1" CornerRadius="7">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" Foreground="#8CC4FF"/>
                                            <TextBlock Text="{Binding Kind}" HorizontalAlignment="Right" Foreground="#BFD0E4"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding TargetTitle}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="9.5" Foreground="#71869E" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#0F1723" BorderBrush="#26364A" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewInfo" Text="Select evidence to preview" FontWeight="SemiBold" Foreground="#BFD0E4"/>
                    <Border Grid.Row="2" Background="#090D14" BorderBrush="#22354A" BorderThickness="1" CornerRadius="8" Padding="8">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
