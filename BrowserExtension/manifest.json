{
  "manifest_version": 3,
  "name": "QAFlow Recorder",
  "version": "1.0.0",
  "description": "Browser QA evidence recorder for web testing. Capture steps, annotations, bugs, screenshots and export an offline QA report.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "downloads", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "QAFlow Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
