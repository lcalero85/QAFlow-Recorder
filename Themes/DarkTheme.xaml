<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Bg0">#090D14</Color>
    <Color x:Key="Bg1">#0E1420</Color>
    <Color x:Key="Bg2">#141D2B</Color>
    <Color x:Key="Bg3">#1A2637</Color>
    <Color x:Key="Border">#26364A</Color>
    <Color x:Key="Text">#F3F7FC</Color>
    <Color x:Key="Muted">#98A8BC</Color>
    <Color x:Key="Accent">#5AA9FF</Color>
    <Color x:Key="Accent2">#7C6CFF</Color>
    <Color x:Key="Green">#3DDC97</Color>
    <Color x:Key="Amber">#F4B860</Color>
    <Color x:Key="Red">#FF6577</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}"/>


    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#111A27"/>
        <Setter Property="Foreground" Value="#F3F7FC"/>
        <Setter Property="BorderBrush" Value="#34465E"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#111A27"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#2B3E54"/><Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#326EA8"/><Setter Property="SelectionOpacity" Value="0.65"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TB" Property="BorderBrush" Value="#5AA9FF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TB" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#F3F7FC"/>
        <Setter Property="Background" Value="#111A27"/>
        <Setter Property="BorderBrush" Value="#26364A"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Outer" Background="#111A27" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="#F3F7FC"/>
                            <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#BFD0E4" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Margin="0,3,0,0" Background="#0F1723" BorderBrush="#33445A" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#5AA9FF"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#111A27"/>
        <Setter Property="Foreground" Value="#F3F7FC"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#22334B"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1F4F7D"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#D7E2EE"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" Margin="0,0,8,0">
                    <Ellipse x:Name="Outer" Fill="#111A27" Stroke="#60758C" StrokeThickness="1.5"/>
                    <Ellipse x:Name="Inner" Width="8" Height="8" Fill="#5AA9FF" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="#5AA9FF"/><Setter TargetName="Inner" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="#8BC5FF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="#5AA9FF"/><Setter Property="Background" Value="#26364A"/>
    </Style>
    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#52677F"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#0B111A"/><Setter Property="Foreground" Value="#52677F"/><Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource DarkScrollThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#D7E2EE"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#111A27" BorderBrush="#60758C" BorderThickness="1.3" Margin="0,0,8,0">
                    <Path x:Name="Check" Data="M 3 8 L 7 12 L 15 4" Stroke="#06101D" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#5AA9FF"/><Setter TargetName="Box" Property="BorderBrush" Value="#5AA9FF"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#8BC5FF"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="#D7E2EE"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="#182436"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#22334B"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="P" CornerRadius="8" BorderBrush="#5AA9FF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#287EEB" Offset="0"/><GradientStop Color="#5AA9FF" Offset="1"/></LinearGradientBrush></Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="P" Property="Opacity" Value="0.92"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="P" Property="Opacity" Value="0.78"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#47212A"/><Setter Property="BorderBrush" Value="#753441"/><Setter Property="Foreground" Value="#FFDDE2"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#1E2C3E"/><Setter Property="RowBackground" Value="#0F1723"/>
        <Setter Property="AlternatingRowBackground" Value="#121C2A"/><Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="#0F1723"/>
        <Setter Property="Foreground" Value="#F3F7FC"/>
        <Setter Property="BorderBrush" Value="#1E2C3E"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#173A5B"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#16263A"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F3F7FC"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,5"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#173A5B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3B82C4"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#182436"/><Setter Property="Foreground" Value="#BFD0E4"/><Setter Property="Padding" Value="8"/>
        <Setter Property="BorderBrush" Value="#26364A"/>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#111A27"/><Setter Property="Padding" Value="12,7"/></Style>
    <Style x:Key="ExportCard" TargetType="Border">
        <Setter Property="Background" Value="#111A27"/><Setter Property="BorderBrush" Value="#26364A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</ResourceDictionary>
