<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Bg0">#DDECF8</Color>
    <Color x:Key="Bg1">#EAF4FC</Color>
    <Color x:Key="Bg2">#F4F9FD</Color>
    <Color x:Key="Bg3">#FFFFFF</Color>
    <Color x:Key="Border">#A9C3D9</Color>
    <Color x:Key="Text">#16324A</Color>
    <Color x:Key="Muted">#627A8E</Color>
    <Color x:Key="Accent">#198ED5</Color>
    <Color x:Key="Accent2">#547DE8</Color>
    <Color x:Key="Green">#168A62</Color>
    <Color x:Key="Amber">#A96A13</Color>
    <Color x:Key="Red">#C84052</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
    <LinearGradientBrush x:Key="Bg1Brush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F9FCFF" Offset="0"/><GradientStop Color="#EAF4FC" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource Green}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource Amber}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource Red}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#946019"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFF1F3"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E2A3AC"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#A62D3C"/>
    <SolidColorBrush x:Key="DangerButtonSurfaceBrush" Color="#FCE8EB"/>
    <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="#D58C98"/>
    <SolidColorBrush x:Key="DangerButtonTextBrush" Color="#8E2634"/>
    <SolidColorBrush x:Key="RecordingOverlayBrush" Color="#F2F5FAFE"/>
    <SolidColorBrush x:Key="MarkupOverlayBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E8F3FB"/>
    <LinearGradientBrush x:Key="SurfaceRaisedBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#EFF8FE" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FCFF"/>
    <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#D9EAF6"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#94B5CF"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#74A9CC"/>
    <SolidColorBrush x:Key="Muted2Brush" Color="#486A84"/>
    <SolidColorBrush x:Key="Muted3Brush" Color="#5B7890"/>
    <SolidColorBrush x:Key="Muted4Brush" Color="#58758D"/>
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="#EEF7FD"/>
    <SolidColorBrush x:Key="SurfacePanel2Brush" Color="#E5F2FA"/>
    <SolidColorBrush x:Key="SurfacePanel3Brush" Color="#DDECF8"/>
    <SolidColorBrush x:Key="SurfaceAccentBrush" Color="#D9EDF9"/>
    <SolidColorBrush x:Key="BorderAltBrush" Color="#8FB4D0"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#58748A"/>
    <SolidColorBrush x:Key="TextSubtle2Brush" Color="#4D718C"/>
    <SolidColorBrush x:Key="TextSubtle3Brush" Color="#57748B"/>
    <SolidColorBrush x:Key="TextSubtle4Brush" Color="#617C91"/>
    <SolidColorBrush x:Key="TextBrightBrush" Color="#17364F"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#0C80C8"/>
    <SolidColorBrush x:Key="SurfaceExact1Brush" Color="#EAF4FC"/>
    <SolidColorBrush x:Key="SurfaceExact2Brush" Color="#EDF7FD"/>
    <SolidColorBrush x:Key="SurfaceExact3Brush" Color="#F6FBFF"/>
    <SolidColorBrush x:Key="SurfaceExact4Brush" Color="#F0F7FC"/>
    <SolidColorBrush x:Key="SurfaceExact5Brush" Color="#F4F9FD"/>
    <SolidColorBrush x:Key="SurfaceExact6Brush" Color="#D8EBF8"/>
    <SolidColorBrush x:Key="SurfaceExact7Brush" Color="#D5E8F5"/>
    <SolidColorBrush x:Key="BorderExact1Brush" Color="#94B4CD"/>
    <SolidColorBrush x:Key="BorderExact2Brush" Color="#84AEC9"/>
    <SolidColorBrush x:Key="BorderExact3Brush" Color="#A7BED2"/>
    <SolidColorBrush x:Key="MutedExact1Brush" Color="#5C7589"/>
    <SolidColorBrush x:Key="MutedExact2Brush" Color="#5A7388"/>
    <SolidColorBrush x:Key="MutedExact3Brush" Color="#58748A"/>
    <SolidColorBrush x:Key="MutedExact4Brush" Color="#5B758A"/>
    <SolidColorBrush x:Key="TextExact1Brush" Color="#35536D"/>
    <SolidColorBrush x:Key="TextExact2Brush" Color="#1F405A"/>


    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F8FCFF"/>
        <Setter Property="Foreground" Value="#16324A"/>
        <Setter Property="BorderBrush" Value="#A7BED2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="#F8FCFF"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="#AFC7DA"/><Setter Property="CaretBrush" Value="White"/>
        <Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#5CAEE0"/><Setter Property="SelectionOpacity" Value="0.65"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TB" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TB" Property="BorderBrush" Value="#198ED5"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TB" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="#16324A"/>
        <Setter Property="Background" Value="#F8FCFF"/>
        <Setter Property="BorderBrush" Value="#A9C3D9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Outer" Background="#F8FCFF" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                        <Grid Margin="10,0,8,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                            <ContentPresenter Margin="0,0,6,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="#16324A"/>
                            <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#35536D" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Margin="0,3,0,0" Background="#F6FBFF" BorderBrush="#33445A" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#198ED5"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#F8FCFF"/>
        <Setter Property="Foreground" Value="#16324A"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#D3E9F8"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1F4F7D"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="#213D55"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18" Margin="0,0,8,0">
                    <Ellipse x:Name="Outer" Fill="#F8FCFF" Stroke="#829CB2" StrokeThickness="1.5"/>
                    <Ellipse x:Name="Inner" Width="8" Height="8" Fill="#198ED5" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="#198ED5"/><Setter TargetName="Inner" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Stroke" Value="#39A6E8"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="#198ED5"/><Setter Property="Background" Value="#A9C3D9"/>
    </Style>
    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#7698B5"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#D5E7F4"/><Setter Property="Foreground" Value="#7698B5"/><Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource DarkScrollThumb}"/></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#213D55"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Box" Width="18" Height="18" CornerRadius="7" Background="#F8FCFF" BorderBrush="#829CB2" BorderThickness="1.3" Margin="0,0,8,0">
                    <Path x:Name="Check" Data="M 3 8 L 7 12 L 15 4" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#198ED5"/><Setter TargetName="Box" Property="BorderBrush" Value="#198ED5"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#39A6E8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="#213D55"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="#E3F1FA"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#D3E9F8"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="P" CornerRadius="8" BorderBrush="#198ED5" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D78C0" Offset="0"/><GradientStop Color="#198ED5" Offset="1"/></LinearGradientBrush></Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="P" Property="Opacity" Value="0.92"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="P" Property="Opacity" Value="0.78"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#F8E5E8"/><Setter Property="BorderBrush" Value="#D58C96"/><Setter Property="Foreground" Value="#7D1E2C"/>
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Bg1Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Bg3Brush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="{DynamicResource Bg2Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="ColumnHeaderHeight" Value="36"/>
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#D4E4F0"/><Setter Property="RowBackground" Value="#F6FBFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F0F7FC"/><Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="#F6FBFF"/>
        <Setter Property="Foreground" Value="#16324A"/>
        <Setter Property="BorderBrush" Value="#D4E4F0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C5E6F8"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E0F0FA"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#16324A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,5"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#C5E6F8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2C91CF"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E3F1FA"/><Setter Property="Foreground" Value="#35536D"/><Setter Property="Padding" Value="8"/>
        <Setter Property="BorderBrush" Value="#A9C3D9"/>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="#F8FCFF"/><Setter Property="Padding" Value="12,7"/></Style>
    <Style x:Key="ExportCard" TargetType="Border">
        <Setter Property="Background" Value="#F8FCFF"/><Setter Property="BorderBrush" Value="#A9C3D9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</ResourceDictionary>
